# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/

# --- Model weights (auto-downloaded) ---
*.pt
*.pth
*.onnx
~/.insightface/

# --- Data & generated artifacts ---
backend/data/videos/
backend/data/frames/
backend/data/crops/
backend/data/faces/
backend/data/faiss_indexes/
backend/data/exports/
backend/data/plate_crops/
backend/data/saved_faces/
backend/data/expanded_crops/
# Derived AI visualisations of saved faces (app/face_enhance.py). Regenerable on
# demand from the source footage, so they are artifacts rather than source.
backend/data/enhanced_faces/
backend/data/_diag_anpr/
backend/data/*.db
backend/data/*.bak_*
backend/data/*.bak
# Local safety copies taken before a destructive migration (scripts/*.py make
# these). They contain a full cctv.db + FAISS indexes, so they must never be
# committed - "backend/data/*.db" above only matches that one directory level.
backend/data/backup_*/
backend/data/vehicle_registry.json
*.bak

# --- Node / frontend ---
node_modules/
dist/
.vite/

# --- Env / editor ---
.env
.env.*
.DS_Store
.idea/
.vscode/
